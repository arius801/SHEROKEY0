# ============================================================
# SHEROKEY — environment template
# Copy to .env. NEVER commit real secrets (.env is gitignored).
# Every value here is consumed SERVER-SIDE ONLY.
# ============================================================

# ---------- REQUIRED (production) ----------
# PostgreSQL — the authoritative database
DATABASE_URL=postgres://user:password@localhost:5432/sherokey
# Session signing secret — 32+ random bytes
AUTH_SECRET=
# Public base URL of the deployed app
APP_URL=https://sherokey.com
# Transactional email provider: resend | ses | smtp
EMAIL_PROVIDER=resend
EMAIL_FROM="SHEROKEY <no-reply@sherokey.com>"

# ---------- REQUIRED per enabled payment provider ----------
# Stripe (international cards). Leave unset → provider reports NOT CONFIGURED.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal. Leave unset → NOT CONFIGURED.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox      # sandbox | live

# MIR-compatible acquirer. Leave unset → MIR reports NOT CONFIGURED (never faked).
MIR_PROVIDER_API_KEY=
MIR_PROVIDER_SECRET=
MIR_PROVIDER_WEBHOOK_SECRET=
MIR_PROVIDER_BASE_URL=
MIR_MERCHANT_ID=

# ---------- OPTIONAL ----------
# Upstash/Redis for server-side rate limiting + webhook idempotency
REDIS_URL=
# Resend (preferred) — or SMTP fallback
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# S3-compatible object storage for product media / signed delivery assets
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# PayPal webhook verification id (used to verify incoming events)
PAYPAL_WEBHOOK_ID=

# ---------- DEVELOPMENT / TEST ONLY ----------
# Set APP_ENV=development to enable the browser sandbox repository adapter.
# Production builds MUST leave this unset (server mode) so the browser is never
# authoritative and there is no silent fallback to localStorage.
APP_ENV=development
# Frontend build-time pointer to the API (production builds).
VITE_API_URL=
