# ============================================================
# SHEROKEY — production environment template
# Copy to .env and fill in real values. NEVER commit .env.
# Every variable here is consumed SERVER-SIDE ONLY — nothing
# in this file may ever reach the browser bundle.
# ============================================================

# --- Application ---
APP_URL=https://sherokey.com
APP_ENV=production            # development | staging | production
NODE_ENV=production
AUTH_SECRET=                  # 32+ random bytes — session signing
COOKIE_SECURE=true            # HttpOnly+Secure+SameSite=Lax session cookie

# --- Database (authoritative source of truth) ---
DATABASE_URL=postgres://user:password@host:5432/sherokey
REDIS_URL=redis://host:6379   # rate limiting + webhook idempotency cache

# --- Stripe (cards: Visa / Mastercard / Amex) ---
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=live       # live | sandbox

# --- MIR-compatible acquirer (provider-specific credentials) ---
MIR_PROVIDER_NAME=            # e.g. the configured acquirer
MIR_PROVIDER_API_KEY=
MIR_PROVIDER_SECRET=
MIR_PROVIDER_WEBHOOK_SECRET=
MIR_MERCHANT_ID=

# --- Email (transactional) ---
EMAIL_PROVIDER=resend         # resend | ses | smtp
EMAIL_FROM="SHEROKEY <no-reply@sherokey.com>"
RESEND_API_KEY=
# SMTP fallback:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Object storage (product media, signed delivery assets) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
